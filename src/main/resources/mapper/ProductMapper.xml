<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper SYSTEM "../mybatis-3-mapper.dtd">

<mapper namespace="com.learn.mapper.ProductMapper">
    <select id="getAllProducts" resultType="com.learn.vo.ProductVO">
        SELECT * FROM product
        WHERE 1=1
        And use_yn = 'Y'
    </select>
</mapper>